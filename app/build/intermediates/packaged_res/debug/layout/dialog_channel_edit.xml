<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/channel_name"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/et_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例如：中央一台"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stream_url"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/et_channel_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例如：udp://@239.0.0.1:1234"
        android:inputType="textUri"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stream_type"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/white" />

    <Spinner
        android:id="@+id/spinner_stream_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
